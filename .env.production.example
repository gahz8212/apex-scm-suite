# ==========================================
# Production Server Environment Configuration
# Save this file as .env on your deployment server (~/apex-scm-suite/.env)
# ==========================================

# Port Configuration (호스트 80번 충돌 방지: 기본 8080 포트)
HTTP_PORT=8080

# Database Settings
DB_ROOT_PASSWORD=your_secure_root_password
DB_DATABASE=auth-toolkit
DB_USERNAME=root
DB_PASSWORD=your_secure_root_password

# Application Security
COOKIE_SECRET=your_cookie_secret_key_here

# External APIs
MSC_COOKIE=your_msc_cookie_value_here

# 1단계: 프론트엔드 빌드
FROM node:18-alpine AS builder

WORKDIR /app

# 의존성 파일 복사 및 설치 (캐시 최적화)
COPY package*.json ./
RUN npm ci

# 소스 복사 및 정적 번들 빌드
COPY . .
ENV CI=false
RUN npm run build

# 2단계: Nginx 경량 컨테이너를 통한 서빙
FROM nginx:alpine

# 빌드 산출물 복사
COPY --from=builder /app/build /usr/share/nginx/html

# Nginx 설정 복사
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
